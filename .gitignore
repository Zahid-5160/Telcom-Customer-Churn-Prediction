# ---------------------------------------------------------------------------
# Project artefacts
# ---------------------------------------------------------------------------
# The trained model is a pickle tied to the scikit-learn version that made it,
# so it is rebuilt locally rather than committed. `python main.py build` or the
# desktop launcher regenerates it in about half a minute.
models/*.joblib

# The prediction log is local runtime state.
reports/*.db

# metrics.json and insights.json ARE committed: they are small, deterministic
# and readable straight from GitHub.

# ---------------------------------------------------------------------------
# Editors / OS / local tooling
# ---------------------------------------------------------------------------
.vscode/
.idea/
.claude/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# First-run marker written by the desktop launcher
.setup-complete
reports/*.db-wal
reports/*.db-shm
